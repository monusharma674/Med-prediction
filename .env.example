# ========================================================
# AI-Powered Medical Report Management & Prediction System
# Environment Configuration Template
# ========================================================

# General Application Settings
PROJECT_NAME="Medical AI Report & Multi-Disease Risk Prediction System"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
# Generate secure key via: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-very-secure-random-32-byte-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local dev; supports PostgreSQL)
DATABASE_URL="sqlite:///./medical_ai.db"
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/medical_ai_db

# File Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=["pdf", "jpg", "jpeg", "png"]

# OCR Configuration
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Blockchain Configuration (Local Hardhat Node)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
BLOCKCHAIN_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Initial Admin Seed Credentials
ADMIN_EMAIL="admin@medicalai.local"
ADMIN_PASSWORD="AdminSecurePassword123!"
ADMIN_NAME="System Administrator"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
